# ============ Server environment for docker-compose.prod.yml ============
# Copy to .env on the server and fill in. Never commit the filled-in file.
# Values marked REQUIRED have no default: compose refuses to start without them.

# --- image ---
# The tag the CI workflow pushed. Prefer a commit SHA over :latest so you know
# exactly what is running and can pull an earlier one to roll back.
DOCKER_IMAGE=youruser/facemenow:<commit-sha>          # REQUIRED
API_PORT=7777                                          # reverse proxy should terminate TLS in front of this
API_MEM_LIMIT=4g

# --- app ---
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LEGACY_API_ENABLED=false
# Comma-separated, no "*": a wildcard turns off allow_credentials and breaks the dashboard.
CORS_ORIGINS=https://dashboard.example.com             # REQUIRED

# --- database ---
# Container-internal DATABASE_URL is built from these by compose; the api never
# uses a DATABASE_URL you set here.
#
# KEEP THESE PASSWORDS ALPHANUMERIC. They are substituted into a connection URL,
# so @ : / # ? break parsing, & truncates the value, and $ is eaten by compose
# interpolation (it would need doubling as $$). Generate one with:
#     openssl rand -hex 24
POSTGRES_USER=facefinder                               # REQUIRED
POSTGRES_PASSWORD=                                     # REQUIRED - alphanumeric, see note above
POSTGRES_DB=facefinder                                 # REQUIRED
POSTGRES_PORT=5555                                     # bound to 127.0.0.1 only

# --- redis ---
REDIS_PASSWORD=                                        # REQUIRED - alphanumeric, same caveat as above
REDIS_PORT=6379                                        # bound to 127.0.0.1 only

# --- supabase auth ---
SUPABASE_URL=https://<project>.supabase.co             # REQUIRED
SUPABASE_ANON_KEY=                                     # public key; only used for the /health probe
SUPABASE_SERVICE_ROLE_KEY=                             # only for STORAGE_BACKEND=supabase
SUPABASE_JWT_AUDIENCE=authenticated
# LEAVE EMPTY for projects using asymmetric keys (ES256/RS256) - the default for
# current Supabase projects. Empty selects JWKS verification against SUPABASE_URL.
# Set it only for an older HS256 project, to that project's JWT secret.
SUPABASE_JWT_SECRET=

# --- object storage ---
STORAGE_BACKEND=minio
STORAGE_BUCKET=faces
SIGNED_URL_TTL_SECONDS=900
MINIO_ACCESS_KEY=                                      # REQUIRED - also the MinIO root user
MINIO_SECRET_KEY=                                      # REQUIRED - also the MinIO root password
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
# The address a browser uses to fetch a signed URL. It must be publicly reachable,
# or images in the dashboard will not load.
MINIO_PUBLIC_URL=https://minio.example.com             # REQUIRED

# --- face engine ---
FACE_ENGINE=insightface
FACE_CTX_ID=-1                                         # -1 CPU, 0 GPU (needs onnxruntime-gpu)
FACE_SIMILARITY_THRESHOLD=0.45

# --- admin ---
# The app refuses to boot in production while this is unset or the placeholder.
ADMIN_JWT_SECRET=                                      # REQUIRED - long random string
# Only used to create the very first admin, on an empty database. Once any admin
# exists these are ignored, so changing them does not reset a forgotten password.
ADMIN_BOOTSTRAP_USERNAME=superadmin
ADMIN_BOOTSTRAP_PASSWORD=

# --- legacy Facemenow app (only when LEGACY_API_ENABLED=true) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
