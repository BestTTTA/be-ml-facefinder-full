# ============ Face Recognition API — environment ============
# Copy to .env and fill in. Never commit real secrets.

# --- app ---
APP_ENV=development                # development | production | test
APP_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000 # comma-separated; "*" only for development
LEGACY_API_ENABLED=false           # mount the old Facemenow event API (main.py) at /legacy

# --- database (PostgreSQL 15+ with the pgvector extension) ---
DATABASE_URL=postgresql://facefinder:facefinder@localhost:5555/facefinder
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# docker compose postgres service
POSTGRES_USER=facefinder
POSTGRES_PASSWORD=facefinder
POSTGRES_DB=facefinder
POSTGRES_PORT=5555

# --- redis (rate limiting, idempotency, request counters) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- supabase auth (Google OAuth is configured in the Supabase dashboard) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # only needed for STORAGE_BACKEND=supabase
SUPABASE_JWT_SECRET=               # Project Settings → API → JWT Secret (HS256 projects). Leave empty to use JWKS (ES256/RS256).
SUPABASE_JWT_AUDIENCE=authenticated

# --- object storage ---
STORAGE_BACKEND=minio              # minio | supabase
STORAGE_BUCKET=faces
SIGNED_URL_TTL_SECONDS=900
MINIO_ENDPOINT=localhost:9100      # host:port, no scheme (compose maps MinIO to 9100 on the host)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SSL=false
MINIO_PUBLIC_URL=http://localhost:9100  # public address embedded in signed URLs (e.g. https://minio.example.com)
MINIO_REGION=us-east-1
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- face engine ---
FACE_ENGINE=insightface            # insightface | fake (tests only)
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_PATH=                   # insightface root; empty = ~/.insightface (models auto-download on first start)
FACE_CTX_ID=-1                     # -1 CPU, 0 GPU (requires onnxruntime-gpu)
FACE_DET_SIZE=640
EMBEDDING_DIMENSION=512
FACE_SIMILARITY_THRESHOLD=0.45     # cosine similarity; tune per deployment
FACE_MAX_FILE_SIZE_BYTES=10485760
FACE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
FACE_ALLOW_MULTIPLE_FACES=false
FACE_SEARCH_TOP_K=5

# --- admin ---
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_BOOTSTRAP_USERNAME=admin     # first SUPER_ADMIN, created on startup if no admin exists
ADMIN_BOOTSTRAP_PASSWORD=          # >= 12 characters; rotate after first login

# --- api keys / limits ---
API_KEY_PREFIX=fr_live_
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
DEFAULT_PACKAGE_NAME=Free
IDEMPOTENCY_TTL_SECONDS=86400

# --- legacy Facemenow app only (LEGACY_API_ENABLED=true) ---
LEGACY_DATABASE_URL=              # separate database! legacy tables clash with the platform schema
BUCKKET_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
